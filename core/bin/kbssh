#!/usr/bin/env python3
"""kbssh <box> '<shell command>': run a command on a trading box as a kbrain agent (full shell, sudo ok).

Boxes come from ~/.config/kbrain/ops.toml. Uses the agents' key (~/.ssh/kbro_ed25519); each box runs it
through core/ops/kbro_gate.py, which logs every command (~/.kbro/audit.log on the box) and refuses live
arming and key dumping (operator policy: agents do everything except arm real money).
Quote the command so pipes and redirects run on the box:
  kbssh rustmaker 'journalctl -u altspot -n 50 --no-pager | grep -c settled'
  kbssh geminibot 'cd ~/geminibot && git pull && sudo systemctl restart gb-quoter'
  kbssh hypephil 'tar czf - data/mmtape_w1/20261101' > w1.tgz
  kbssh list
"""
import os, subprocess, sys, time, tomllib
from pathlib import Path

OPS = Path(os.environ.get("KB_OPS", Path.home() / ".config" / "kbrain" / "ops.toml"))
KEY = Path.home() / ".ssh" / "kbro_ed25519"

def main(argv):
    boxes = {b["name"]: b for b in tomllib.loads(OPS.read_text()).get("box", [])} if OPS.is_file() else {}
    if len(argv) < 1 or argv[0] in ("-h", "--help"):
        print(__doc__); return 0
    if argv[0] == "list":
        for b in boxes.values():
            print(f"{b['name']:<11} {b.get('where', '')}\n{'':<11} {b.get('role', '')}")
        return 0
    if argv[0] not in boxes:
        print(f"unknown box {argv[0]!r}; known: {', '.join(boxes)}", file=sys.stderr); return 2
    if len(argv) < 2:
        print("give a command, e.g. kbssh rustmaker systemctl status altspot --no-pager", file=sys.stderr); return 2
    b = boxes[argv[0]]
    cmd = ["ssh", "-i", str(KEY), "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "ConnectTimeout=10",
           "-o", "StrictHostKeyChecking=accept-new", "-o", "LogLevel=ERROR", f"{b['user']}@{b['host']}", " ".join(argv[1:])]
    for log in (Path.home() / ".local/state/kbrain/kbssh.log", Path("kbssh.log")):   # local audit trail
        try:
            log.parent.mkdir(parents=True, exist_ok=True)
            with open(log, "a") as f:
                f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\t{os.getcwd()}\t{argv[0]}\t{' '.join(argv[1:])}\n")
            break
        except OSError:
            continue
    try:
        return subprocess.run(cmd, timeout=360).returncode
    except subprocess.TimeoutExpired:
        print("kbssh: timed out", file=sys.stderr); return 124

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
