[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
# The agent's own supervisor handles backoff; systemd must not give up on it.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="__HERMES_HOME__/hermes-agent/.hermes/bin/hermes" "gateway" "run"
WorkingDirectory=__HERMES_HOME__
Environment="PATH=__HERMES_HOME__/hermes-agent/node_modules/.bin:__HERMES_HOME__/tools/node-26.7.0-linux-x64/bin:__HERMES_HOME__/tools/npm-12.0.2-linux-x64/bin:__HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

Environment="HERMES_HOME=__HERMES_HOME__"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
# 75 = the agent asking to be recycled; 78 = the agent saying "my config is
# broken, restarting will not help". Honour both or you get a restart loop.
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
# SIGUSR1 reloads config without dropping the Telegram session.
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-"__HERMES_HOME__/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.systemd_stop_mark"
ExecStopPost=-"__HERMES_HOME__/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.cgroup_cleanup"
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
