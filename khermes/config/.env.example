# Hermes gateway environment. Copy to $HERMES_HOME/.env and fill in.
#
#   install -m 600 /dev/null ~/.hermes/.env   # create it 0600 FIRST
#   $EDITOR ~/.hermes/.env
#
# The live file is mode 0600 and holds real credentials. It is never committed;
# kbrain's .gitignore blocks .env and gitleaks runs over this repo.

# ---- required: messaging ----
# From @BotFather. Whoever holds this controls the bot.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Comma-separated numeric user IDs. This is the ONLY thing standing between
# your agent's shell tools and any stranger who finds the bot. Never empty.
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID_HERE
# Numeric chat ID the agent treats as home.
TELEGRAM_HOME_CHANNEL=YOUR_TELEGRAM_CHAT_ID_HERE

# ---- required: model provider ----
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# Only if you authenticate by OAuth token rather than API key; otherwise omit.
ANTHROPIC_TOKEN=YOUR_ANTHROPIC_TOKEN_HERE

# ---- optional: tool providers ----
# Web search. Omit to disable the research toolset.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE
# Google APIs used by the media/vision toolsets.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# ---- browser toolset ----
BROWSERBASE_ADVANCED_STEALTH=false
BROWSERBASE_PROXIES=false
BROWSER_SESSION_TIMEOUT=600
BROWSER_INACTIVITY_TIMEOUT=180

# ---- terminal toolset ----
TERMINAL_TIMEOUT=120
TERMINAL_LIFETIME_SECONDS=3600
TERMINAL_MODAL_IMAGE=

# ---- debug switches, all off in production ----
WEB_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
