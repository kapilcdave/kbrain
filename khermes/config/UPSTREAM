UPSTREAM_SHA=1fd18277267152893a8a24792b79213e7ca3f899

# Official installer, which fetches the self-managed toolchain into
# $HERMES_HOME/tools and creates $HERMES_HOME/hermes-agent/.hermes/bin/hermes
INSTALLER_URL=https://hermes-agent.nousresearch.com/install.sh

